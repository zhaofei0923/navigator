DEMO_API_BASE_URL=http://localhost:8000
DEMO_API_KEY=replace-for-local-demo
DEMO_SHARED_PASSPHRASE=replace-for-local-demo
SESSION_SECRET=replace-with-a-different-long-random-value
DEMO_COOKIE_SECURE=false

# Runtime profiles:
# - synthetic_demo: original five-country synthetic fixture application.
# - basic60_private: standalone /basic60 private-trial surface.
# - approved_basic60_demo: approved Basic60 data at the original Demo routes,
#   with direct loopback access and no Demo passphrase or session cookie.
NAVIGATOR_RUNTIME_PROFILE=synthetic_demo
BASIC60_API_BASE_URL=http://localhost:8001
BASIC60_API_KEY=replace-with-a-distinct-private-trial-api-key
BASIC60_SHARED_PASSPHRASE=replace-with-a-distinct-private-trial-passphrase
BASIC60_SESSION_SECRET=replace-with-a-distinct-random-secret-of-at-least-32-characters
BASIC60_COOKIE_SECURE=false
