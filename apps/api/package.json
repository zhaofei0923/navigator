{
  "name": "@navigator/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "pnpm --filter @navigator/shared-types build && pnpm --filter @navigator/db build",
    "build": "tsc --project tsconfig.build.json",
    "lint": "tsc --project tsconfig.json --noEmit --pretty false",
    "load:readonly": "node scripts/load-read-only.mjs",
    "typecheck": "tsc --project tsconfig.json --noEmit --pretty false",
    "test": "vitest run",
    "start": "node dist/main.js",
    "smoke:dist": "node scripts/runtime-smoke.mjs"
  },
  "dependencies": {
    "@navigator/db": "workspace:*",
    "@navigator/shared-types": "workspace:*",
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "11.1.28"
  }
}
