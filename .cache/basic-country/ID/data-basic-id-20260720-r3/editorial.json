    { "fieldPath": "country.name", "normalizedValue": { "zh": "印度尼西亚", "en": "Indonesia" }, "evidence": [{ "sourceId": "world-bank-country", "locator": "json:/1/0/name", "rawValue": "Indonesia", "unit": null, "year": null }], "uncertainty": null },
    { "fieldPath": "country.region", "normalizedValue": "southeast-asia", "evidence": [{ "sourceId": "indonesia-esdm-2025-performance", "locator": "html:press-release-002-pers-04-sji-2026#masthead-country", "rawValue": "REPUBLIK INDONESIA", "unit": null, "year": null }], "uncertainty": "The source establishes the Indonesia country identity; southeast-asia is a manual mapping to the project's region taxonomy." },
    { "fieldPath": "country.summary", "normalizedValue": { "zh": "印度尼西亚2025年可再生能源占能源结构15.75%，人均用电量1,584千瓦时；同期电源装机容量继续扩大。", "en": "In 2025, renewables accounted for 15.75% of Indonesia's energy mix and electricity consumption was 1,584 kWh per capita; generation capacity also continued to expand." }, "evidence": [{ "sourceId": "indonesia-esdm-2025-performance", "locator": "html:press-release-002-pers-04-sji-2026#paragraph-129", "rawValue": { "renewableMixPercent": 15.75 }, "unit": null, "year": null }, { "sourceId": "indonesia-esdm-2025-performance", "locator": "html:press-release-002-pers-04-sji-2026#paragraph-132", "rawValue": { "electricityConsumptionKwhPerCapita": 1584, "generationCapacityGw": 107.51 }, "unit": null, "year": null }], "uncertainty": null },
    { "fieldPath": "marketOverview.energyDemand", "normalizedValue": { "zh": "2025年人均用电量为1,584千瓦时，高于2024年的1,411千瓦时；电源装机容量同比增加7吉瓦至107.51吉瓦。", "en": "Electricity consumption per capita was 1,584 kWh in 2025, up from 1,411 kWh in 2024; installed generation capacity increased by 7 GW to 107.51 GW." }, "evidence": [{ "sourceId": "indonesia-esdm-2025-performance", "locator": "html:press-release-002-pers-04-sji-2026#paragraph-132", "rawValue": { "electricityConsumption2024KwhPerCapita": 1411, "electricityConsumption2025KwhPerCapita": 1584, "generationCapacity2025Gw": 107.51, "generationCapacityIncreaseGw": 7 }, "unit": null, "year": null }], "uncertainty": null },
    { "fieldPath": "marketOverview.industryTags", "normalizedValue": ["grid", "solar", "wind"], "evidence": [{ "sourceId": "indonesia-esdm-2025-performance", "locator": "html:press-release-002-pers-04-sji-2026#paragraph-132", "rawValue": "installed generation capacity", "unit": null, "year": null }], "uncertainty": null },
    { "fieldPath": "marketOverview.keyIndicators[0].label", "normalizedValue": { "zh": "可再生能源占比", "en": "Renewable energy mix share" }, "evidence": [{ "sourceId": "indonesia-esdm-2025-performance", "locator": "html:press-release-002-pers-04-sji-2026#paragraph-129", "rawValue": "bauran energi dari EBT", "unit": null, "year": null }], "uncertainty": null },
    { "fieldPath": "marketOverview.keyIndicators[1].label", "normalizedValue": { "zh": "人均用电量", "en": "Electricity consumption per capita" }, "evidence": [{ "sourceId": "indonesia-esdm-2025-performance", "locator": "html:press-release-002-pers-04-sji-2026#paragraph-132", "rawValue": "konsumsi listrik perkapita", "unit": null, "year": null }], "uncertainty": null },
    { "fieldPath": "marketOverview.overview", "normalizedValue": { "zh": "2025年能源与矿产领域投资为317亿美元，其中电力46亿美元、可再生能源与节能24亿美元。", "en": "Energy and mineral investment reached USD 31.7 billion in 2025, including USD 4.6 billion in electricity and USD 2.4 billion in renewables and conservation." }, "evidence": [{ "sourceId": "indonesia-esdm-2025-performance", "locator": "html:press-release-002-pers-04-sji-2026#paragraph-127", "rawValue": { "electricityInvestmentUsdBillion": 4.6, "renewablesConservationInvestmentUsdBillion": 2.4, "totalInvestmentUsdBillion": 31.7 }, "unit": null, "year": null }], "uncertainty": null },
    { "fieldPath": "marketOverview.renewableTarget", "normalizedValue": { "zh": "经核验的能源矿产资源部2025年实际数据表明，可再生能源占能源结构15.75%；该来源未在本草案中验证任何中长期目标。", "en": "The verified 2025 Ministry data reports renewables at 15.75% of the energy mix; this draft does not verify any medium- or long-term target from this source." }, "evidence": [{ "sourceId": "indonesia-esdm-2025-performance", "locator": "html:press-release-002-pers-04-sji-2026#paragraph-129", "rawValue": { "actualRenewableMixPercent": 15.75, "year": 2025 }, "unit": null, "year": null }], "uncertainty": "This field records a verified 2025 actual share, not a verified target, because the current policy PDF was not collected in this run." },
