    "sources": [{ "id": "iea-policies", "publisher": "International Energy Agency", "title": { "zh": "印尼国家电力总规划", "en": "Indonesia National Electricity General Plan" }, "url": "https://www.iea.org/policies/30494-national-electricity-general-plan", "publishedAt": null, "retrievedAt": "2026-07-20T10:44:13Z", "credibility": "OFFICIAL" }],
    "auditSources": [{ "sourceId": "iea-policies", "sourceName": "International Energy Agency", "sourceUrl": "https://www.iea.org/policies/30494-national-electricity-general-plan", "retrievedAt": "2026-07-20T10:44:13Z", "publishedAt": null, "contentSha256": "c3bb16dabbce40e799bb23ec8152075efa7d59f94df038309f626000a6db948d", "evidenceLocators": ["iea-policy:30494#national-electricity-general-plan-targets"], "sourceFamily": "international-organization", "accessStatus": "open", "accessNotes": null, "credibility": "OFFICIAL", "discoveryOnly": false, "promptInjectionRisk": "none" }],
    "fields": [
      { "category": "marketSummary", "field": { "key": "opportunitySummary", "label": { "zh": "市场机会摘要", "en": "Market opportunity summary" }, "status": "AVAILABLE", "value": { "zh": "对中国新能源企业而言，IEA记录的印尼国家电力总规划可作为跟踪当地电力转型政策的线索。该政策在2025年生效，并记录了到2060年新能源和可再生能源约占能源结构73.6%的目标。进入、融资、项目储备及并网条件仍需以进一步尽调核实。", "en": "For Chinese new-energy companies, the IEA-recorded National Electricity General Plan is a lead for tracking Indonesia's power-transition policy. It took effect in 2025 and records a target for new and renewable energy to reach about 73.6% of the energy mix by 2060. Market entry, financing, project pipeline, and grid conditions still require further due diligence." }, "unit": null, "year": null, "sourceIds": ["iea-policies"], "checkedAt": "2026-07-20", "reason": null, "note": null } },
      { "category": "policyOverview", "field": { "key": "summary", "label": { "zh": "政策摘要", "en": "Policy summary" }, "status": "AVAILABLE", "value": { "zh": "IEA政策页将印尼国家电力总规划列为2025年生效的国家政策，并记录到2060年新能源和可再生能源约占能源结构73.6%的目标。", "en": "The IEA policy page lists Indonesia's National Electricity General Plan as a national policy in force from 2025 and records a target for new and renewable energy to reach about 73.6% of the energy mix by 2060." }, "unit": null, "year": null, "sourceIds": ["iea-policies"], "checkedAt": "2026-07-20", "reason": null, "note": null } },
      { "category": "windResource", "field": { "key": "resourceSummary", "label": { "zh": "风资源摘要", "en": "Wind resource summary" }, "status": "NOT_AVAILABLE", "value": null, "unit": null, "year": null, "sourceIds": ["global-wind-atlas"], "checkedAt": "2026-07-20", "reason": { "zh": "未取得经审核的国家风资源等级及聚合方法，无法生成风资源摘要", "en": "No reviewed national wind class and aggregation method were obtained, so a wind-resource summary is not available" }, "note": null } }
