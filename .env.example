NODE_ENV=development
APP_BASE_URL=http://localhost:3000
LOG_LEVEL=info

API_PORT=3100
COUNTRY_READ_SOURCE=database
CANONICAL_REPOSITORY_ROOT=/absolute/path/to/navigator
API_INTERNAL_BASE_URL=http://127.0.0.1:3100/api/v1

DATABASE_URL=postgresql://navigator_user:navigator_password@localhost:5432/navigator
DATABASE_POOL_MAX=10
DATABASE_POOL_TIMEOUT_SECONDS=5
DATABASE_CONNECT_TIMEOUT_SECONDS=5
SHADOW_DATABASE_URL=postgresql://navigator_user:navigator_password@localhost:5432/navigator_shadow
PGVECTOR_DIMENSION=1536

AUTH_JWT_SECRET=replace-with-local-jwt-secret
AUTH_JWT_EXPIRES_IN=2h
AUTH_SESSION_COOKIE_NAME=navigator_session
LEAD_ENCRYPTION_KEY=replace-with-local-lead-encryption-key

AI_PROVIDER=replace-with-ai-provider
AI_API_KEY=replace-with-local-ai-api-key
AI_CHAT_MODEL=replace-with-chat-model
AI_EMBEDDING_MODEL=replace-with-embedding-model
AI_RATE_LIMIT_PER_MIN=20

NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_MAP_TOKEN=replace-with-public-map-token
NEXT_PUBLIC_DEFAULT_LOCALE=zh-CN
TARO_APP_API_BASE_URL=http://localhost:3000/api/v1
