,576吉瓦时；该指标扣除抽水电量且不含代输电量。"},"unit":null,"year":null}],"extractionMethod":"manual","uncertainty":null},{"factId":"fact-2154acce5e9d2de9","fieldPath":"marketOverview.gdp","status":"candidate","evidence":[{"sourceId":"world-bank-gdp","locator":"json:/1/0/value","rawValue":427184325997.307,"normalizedValue":427184325997.307,"unit":"current US$","year":2025}],"extractionMethod":"deterministic","uncertainty":null},{"factId":"fact-b02014a0fc710b23","fieldPath":"marketOverview.gdpGrowth","status":"candidate","evidence":[{"sourceId":"world-bank-gdp-growth","locator":"json:/1/0/value","rawValue":1.11462608103956,"normalizedValue":1.11462608103956,"unit":"%","year":2025}],"extractionMethod":"deterministic","uncertainty":null},{"factId":"fact-50f5c5ab5ae6f857","fieldPath":"marketOverview.industryTags","status":"candidate","evidence":[{"sourceId":"south-africa-eskom-results-presentation-2025","locator":"pdf:page=11#slide-10-eskom-only-energy-sent-out-fy2025","rawValue":"Eskom-only energy sent out, net of pumping and excluding wheeling","normalizedValue":["grid","solar","storage","wind"],"unit":null,"year":null},{"sourceId":"south-africa-government-irp-2025","locator":"pdf:page=39#printed-30-current-base-capacity","rawValue":{"gridTiedSolarMW":3646,"windMW":5344},"normalizedValue":["grid","solar","storage","wind"],"unit":null,"year":null},{"sourceId":"south-africa-government-rmippp-hybrid-projects-2023","locator":"html:body#rmippp-hybrid-projects-203mw","rawValue":"Solar PV, Onshore Wind and Battery Storage","normalizedValue":["grid","solar","storage","wind"],"unit":null,"year":null}],"extractionMethod":"manual","uncertainty":null},{"factId":"fact-a2c20de33611c938","fieldPath":"marketOverview.keyIndicators[0].label","status":"candidate","evidence":[{"sourceId":"south-africa-eskom-results-presentation-2025","locator":"pdf:page=18#slide-17-sales-volumes-fy2025","rawValue":"Sales volumes 189.7 TWh in FY2025","normalizedValue":{"en":"Eskom electricity sales volume","zh":"Eskom售电量"},"unit":null,"year":null}],"extractionMethod":"manual","uncertainty":null},{"factId":"fact-2503bb4af0bf0a42","fieldPath":"marketOverview.keyIndicators[0].unit","status":"candidate","evidence":[{"sourceId":"south-africa-eskom-results-presentation-2025","locator":"pdf:page=18#slide-17-sales-volumes-fy2025","rawValue":"TWh","normalizedValue":"TWh","unit":null,"year":null}],"extractionMethod":"manual","uncertainty":null},{"factId":"fact-2b49c11aab46387b","fieldPath":"marketOverview.keyIndicators[0].value","status":"candidate","evidence":[{"sourceId":"south-africa-eskom-results-presentation-2025","locator":"pdf:page=18#slide-17-sales-volumes-fy2025","rawValue":189.7,"normalizedValue":"189.7","unit":"TWh","year":2025}],"extractionMethod":"manual","uncertainty":null},{"factId":"fact-170892ea31c946f2","fieldPath":"marketOverview.keyIndicators[0].year","status":"candidate","evidence":[{"sourceId":"south-africa-eskom-results-presentation-2025","locator":"pdf:page=18#slide-17-sales-volumes-fy2025","rawValue":2025,"normalizedValue":2025,"unit":"TWh","year":2025}],"extractionMethod":"manual","uncertainty":null},{"factId":"fact-d80f1b9a77e0454b","fieldPath":"marketOverview.keyIndicators[1].label","status":"candidate","evidence":[{"sourceId":"south-africa-eskom-results-presentation-2025","locator":"pdf:page=11#slide-10-eskom-only-energy-sent-out-fy2025","rawValue":"Eskom-only energy sent out 195,702 GWh in FY2025","normalizedValue":{"en":"Eskom-only energy sent out","zh":"Eskom自发电量"},"unit":null,"year":null}],"extractionMethod":"manual","uncertainty":null},{"factId":"fact-c8b1ec343b58101c","fieldPath":"marketOverview.keyIndicators[1].unit","status":"candidate","evidence":[{"sourceId":"south-africa-eskom-results-presentation-2025","locator":"pdf:page=11#slide-10-eskom-only-energy-sent-out-fy2025","rawValue":"GWh","normalizedValue":"GWh","unit":null,"year":null}],"extractionMethod":"manual","uncertainty":null},{"factId":"fact-85854112862223ad","fieldPath":"marketOverview.keyIndicators[1].value","status":"candidate","evidence":[{"sourceId":"south-africa-eskom-results-presentation-2025","locator":"pdf:page=11#slide-10-eskom-only-energy-sent-out-fy2025","rawValue":195702,"normalizedValue":"195702","unit":"GWh","year":2025}],"extractionMethod":"manual","uncertainty":null},{"factId":"fact-807ab42a9918094e","fieldPath":"marketOverview.keyIndicators[1].year","status":"candidate","evidence":[{"sourceId":"south-africa-eskom-results-presentation-2025","locator":"pdf:page=11#slide-10-eskom-only-energy-sent-out-fy2025","rawValue":2025,"normalizedValue":2025,"unit":"GWh","year":2025}],"extractionMethod":"manual","uncertainty":null},{"factId":"fact-712e29955bb2591c","fieldPath":"marketOverview.keyIndicators[2].label","status":"candidate","evidence":[{"sourceId":"south-africa-government-irp-2025","locator":"pdf:page=40#printed-31-balanced-plan-wind-additions-2026-2042","rawValue":"Balanced-plan proposed wind additions, 2026-2042","normalizedValue":{"en":"Planned wind additions","zh":"规划新增风电容量"},"unit":null,"year":null}],"extractionMethod":"manual","uncertainty":"Cumulative plan for 2026-2042, not built or procured capacity."},{"factId":"fact-d70ecc73d437cd27","fieldPath":"marketOverview.keyIndicators[2].unit","status":"candidate","evidence":[{"sourceId":"south-africa-government-irp-2025","locator":"pdf:page=40#printed-31-balanced-plan-wind-additions-2026-2042","rawValue":"MW","normalizedValue":"MW","unit":null,"year":null}],"extractionMethod":"manual","uncertainty":null},{"factId":"fact-80ff3a34c9332440","fieldPath":"marketOverview.keyIndicators[2].value","status":"candidate","evidence":[{"sourceId":"south-africa-government-irp-2025","locator":"pdf:page=40#printed-31-balanced-plan-wind-additions-2026-2042","rawValue":43041,"normalizedValue":"43041","unit":"MW","year":2042}],"extractionMethod":"manual","uncertainty":null},{"factId":"fact-ef0eda44985626d2","fieldPath":"marketOverview.keyIndicators[2].year","status":"candidate","evidence":[{"sourceId":"south-africa-government-irp-2025","locator":"pdf:page=40#printed-31-balanced-plan-wind-additions-2026-2042","rawValue":2042,"normalizedValue":2042,"unit":"MW","year":2042}],"extractionMethod":"manual","uncertainty":null},{"factId":"fact-80a1e8804101bcd9","fieldPath":"marketOverview.overview","status":"candidate","evidence":[{"sourceId":"south-africa-eskom-results-presentation-2025","locator":"pdf:page=11#slide-10-eskom-only-energy-sent-out-fy2025","rawValue":"FY2025 Eskom-only energy sent out was 195,702 GWh, net of pumping and excluding wheeling.","normalizedValue":{"en":"Eskom reported 189.7 TWh of sales volumes and 195,702 GWh of Eskom-only energy sent out in FY2025, net of pumping and excluding wheeling. Integrated Resource Plan 2025 lists 5,344 MW of wind and 3,646 MW of grid-tied solar in its current base; a 2023 RMIPPPP announcement covered two hybrid renewable projects totaling 203 MW using solar PV, onshore wind, and battery storage.","zh":"Eskom在2025财年的售电量为189.7太瓦时，Eskom自发并送出电量为195,702吉瓦时（扣除抽水电量且不含代输电量）。《综合资源计划2025》在当前基础中列示风电5,344兆瓦和并网太阳能3,646兆瓦；2023年RMIPPPP公告的两个混合可再生能源项目共203兆瓦，采用光伏、陆上风电和储能。"},"unit":null,"year":null},{"sourceId":"south-africa-government-irp-2025","locator":"pdf:page=39#printed-30-current-base-capacity","rawValue":{"gridTiedSolarMW":3646,"scope":"installed, under construction, and deemed online in 2025","windMW":5344},"normalizedValue":{"en":"Eskom reported 189.7 TWh of sales volumes and 195,702 GWh of Eskom-only energy sent out in FY2025, net of pumping and excluding wheeling. Integrated Resource Plan 2025 lists 5,344 MW of wind and 3,646 MW of grid-tied solar in its current base; a 2023 RMIPPPP announcement covered two hybrid renewable projects totaling 203 MW using solar PV, onshore wind, and battery storage.","zh":"Eskom在2025财年的售电量为189.7太瓦时，Eskom自发并送出电量为195,702吉瓦时（扣除抽水电量且不含代输电量）。《综合资源计划2025》在当前基础中列示风电5,344兆瓦和并网太阳能3,646兆瓦；2023年RMIPPPP公告的两个混合可再生能源项目共203兆瓦，采用光伏、陆上风电和储能。"},"unit":null,"year":null},{"sourceId":"south-africa-government-rmippp-hybrid-projects-2023","locator":"html:body#rmippp-hybrid-projects-203mw","rawValue":"Two hybrid renewable projects totaling 203 MW combine Solar PV, Onshore Wind and Battery Storage.","normalizedValue":{"en":"Eskom reported 189.7 TWh of sales volumes and 195,702 GWh of Eskom-only energy sent out in FY2025, net of pumping and excluding wheeling. Integrated Resource Plan 2025 lists 5,344 MW of wind and 3,646 MW of grid-tied solar in its current base; a 2023 RMIPPPP announcement covered two hybrid renewable projects totaling 203 MW using solar PV, onshore wind, and battery storage.","zh":"Eskom在2025财年的售电量为189.7太瓦时，Eskom自发并送出电量为195,702吉瓦时（扣除抽水电量且不含代输电量）。《综合资源计划2025》在当前基础中列示风电5,344兆瓦和并网太阳能3,646兆瓦；2023年RMIPPPP公告的两个混合可再生能源项目共203兆瓦，采用光伏、陆上风电和储能。"},"unit":null,"year":null}],"extractionMethod":"manual","uncertainty":null},{"factId":"fact-23ca2a3293b7ec25","fieldPath":"marketOverview.population","status":"candidate","evidence":[{"sourceId":"world-bank-population","locator":"json:/1/0/value","rawValue":64747319,"normalizedValue":64747319,"unit":"people","year":2025}],"extractionMethod":"deterministic","uncertainty":null},{"factId":"fact-d2f22001f3963d95","fieldPath":"marketOverview.renewableTarget","status":"candidate","evidence":[{"sourceId":"south-africa-government-irp-2025","locator":"pdf:page=40#printed-31-balanced-plan-additions-2026-2042","rawValue":{"period":"2026-2042","scope":"cumulative proposed additions","solarMW":28713,"windMW":43041},"normalizedValue":{"en":"The Integrated Resource Plan 2025 balanced plan proposes cumulative additions of 28,713 MW of solar and 43,041 MW of wind for 2026-2042. These are cumulative plan additions, not built or procured capacity.","zh":"《综合资源计划2025》的平衡方案提出，2026至2042年累计新增太阳能28,713兆瓦、风电43,041兆瓦。这些数值是规划中的累计新增容量，不代表已建成或已采购容量。"},"unit":null,"year":null}],"extractionMethod":"manual","uncertainty":null},{"factId":"fact-77a3f126639e9ebb","fieldPath":"marketOverview.source","status":"candidate","evidence":[{"sourceId":"south-africa-government-irp-2025","locator":"metadata:/sourceName","rawValue":"Government of South Africa","normalizedValue":"Government of South Africa","unit":null,"year":null}],"extractionMethod":"deterministic","uncertainty":null},{"factId":"fact-59776c7311313e06","fieldPath":"marketOverview.sourceUrl","status":"candidate","evidence":[{"sourceId":"south-africa-government-irp-2025","locator":"metadata:/sourceUrl","rawValue":"https://www.gov.za/sites/default/files/gcis_document/202510/53596gon6767.pdf","normalizedValue":"https://www.gov.za/sites/default/files/gcis_document/202510/53596gon6767.pdf","unit":null,"year":null}],"extractionMethod":"deterministic","uncertainty":null},{"factId":"fact-3ce6d5eeeaaf5a1a","fieldPath":"marketOverview.techTags","status":"candidate","evidence":[{"sourceId":"south-africa-government-rmippp-hybrid-projects-2023","locator":"html:body#rmippp-hybrid-projects-203mw","rawValue":"Onshore Wind","normalizedValue":["onshore-wind"],"unit":null,"year":null}],"extractionMethod":"manual","uncertainty":null},{"factId":"fact-65da6c2d933a7d37","fieldPath":"marketOverview.updatedAt","status":"candidate","evidence":[{"sourceId":"south-africa-government-rmippp-hybrid-projects-2023","locator":"metadata:/publishedAt","rawValue":"2023-08-30T12:00:00.000Z","normalizedValue":"2023-08-30T12:00:00.000Z","unit":null,"year":null}],"extractionMethod":"deterministic","uncertainty":null}]}
