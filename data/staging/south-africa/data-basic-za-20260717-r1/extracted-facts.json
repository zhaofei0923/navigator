{"schemaVersion":"basic-country-audit/v2","runId":"data-basic-za-20260717-r1","countryCode":"ZA","facts":[{"factId":"fact-058b82f953852e90","fieldPath":"country.code","status":"candidate","evidence":[{"sourceId":"world-bank-country","locator":"json:/1/0/iso2Code","rawValue":"ZA","normalizedValue":"ZA","unit":null,"year":null}],"extractionMethod":"deterministic","uncertainty":null},{"factId":"fact-d1efea471b0191f9","fieldPath":"country.flagEmoji","status":"candidate","evidence":[{"sourceId":"world-bank-country","locator":"json:/1/0/iso2Code","rawValue":"ZA","normalizedValue":"🇿🇦","unit":null,"year":null}],"extractionMethod":"deterministic","uncertainty":null},{"factId":"fact-9344a8cad5365b87","fieldPath":"country.name","status":"candidate","evidence":[{"sourceId":"world-bank-country","locator":"json:/1/0/name","rawValue":"South Africa","normalizedValue":{"en":"South Africa","zh":"南非"},"unit":null,"year":null}],"extractionMethod":"manual","uncertainty":null},{"factId":"fact-d4f2e21182713301","fieldPath":"country.region","status":"candidate","evidence":[{"sourceId":"south-africa-government-irp-2025","locator":"pdf:page=39#printed-30-current-base-capacity","rawValue":"South Africa Integrated Resource Plan 2025","normalizedValue":"africa","unit":null,"year":null}],"extractionMethod":"manual","uncertainty":null},{"factId":"fact-071b0c8c0dd1e49c","fieldPath":"country.summary","status":"candidate","evidence":[{"sourceId":"south-africa-eskom-results-presentation-2025","locator":"pdf:page=18#slide-17-sales-volumes-fy2025","rawValue":{"FY2024SalesVolumesTWh":183.3,"FY2025SalesVolumesTWh":189.7,"growthPercent":3.5},"normalizedValue":{"en":"South Africa's power system is served by Eskom as its principal grid operator. Eskom reported 189.7 TWh of sales volumes in FY2025; the government's Integrated Resource Plan 2025 lists current wind and grid-tied solar capacity and proposes cumulative wind and solar additions for 2026-2042. A 2023 announcement covered two hybrid renewable projects totaling 203 MW using solar PV, onshore wind, and battery storage.","zh":"南非电力系统以Eskom为主要电网运营商。Eskom在2025财年的售电量为189.7太瓦时；政府的《综合资源计划2025》列明现有风电和并网太阳能容量，并提出2026至2042年的累计新增风电和太阳能计划。2023年公告的两个混合可再生能源项目总计203兆瓦，采用光伏、陆上风电和储能技术。"},"unit":null,"year":null},{"sourceId":"south-africa-government-irp-2025","locator":"pdf:page=40#printed-31-balanced-plan-additions-2026-2042","rawValue":{"period":"2026-2042","solarMW":28713,"windMW":43041},"normalizedValue":{"en":"South Africa's power system is served by Eskom as its principal grid operator. Eskom reported 189.7 TWh of sales volumes in FY2025; the government's Integrated Resource Plan 2025 lists current wind and grid-tied solar capacity and proposes cumulative wind and solar additions for 2026-2042. A 2023 announcement covered two hybrid renewable projects totaling 203 MW using solar PV, onshore wind, and battery storage.","zh":"南非电力系统以Eskom为主要电网运营商。Eskom在2025财年的售电量为189.7太瓦时；政府的《综合资源计划2025》列明现有风电和并网太阳能容量，并提出2026至2042年的累计新增风电和太阳能计划。2023年公告的两个混合可再生能源项目总计203兆瓦，采用光伏、陆上风电和储能技术。"},"unit":null,"year":null},{"sourceId":"south-africa-government-rmippp-hybrid-projects-2023","locator":"html:body#rmippp-hybrid-projects-203mw","rawValue":{"projects":2,"technologies":["Solar PV","Onshore Wind","Battery Storage"],"totalMW":203},"normalizedValue":{"en":"South Africa's power system is served by Eskom as its principal grid operator. Eskom reported 189.7 TWh of sales volumes in FY2025; the government's Integrated Resource Plan 2025 lists current wind and grid-tied solar capacity and proposes cumulative wind and solar additions for 2026-2042. A 2023 announcement covered two hybrid renewable projects totaling 203 MW using solar PV, onshore wind, and battery storage.","zh":"南非电力系统以Eskom为主要电网运营商。Eskom在2025财年的售电量为189.7太瓦时；政府的《综合资源计划2025》列明现有风电和并网太阳能容量，并提出2026至2042年的累计新增风电和太阳能计划。2023年公告的两个混合可再生能源项目总计203兆瓦，采用光伏、陆上风电和储能技术。"},"unit":null,"year":null}],"extractionMethod":"manual","uncertainty":null},{"factId":"fact-b22618b0400c8e05","fieldPath":"country.updatedAt","status":"candidate","evidence":[{"sourceId":"south-africa-government-rmippp-hybrid-projects-2023","locator":"metadata:/publishedAt","rawValue":"2023-08-30T12:00:00.000Z","normalizedValue":"2023-08-30T12:00:00.000Z","unit":null,"year":null}],"extractionMethod":"deterministic","uncertainty":null},{"factId":"fact-f0024039905d7b15","fieldPath":"marketOverview.collectedAt","status":"candidate","evidence":[{"sourceId":"south-africa-eskom-results-presentation-2025","locator":"capture:/retrievedAt","rawValue":"2026-07-17T16:14:44.039Z","normalizedValue":"2026-07-17T16:15:17.173Z","unit":null,"year":null},{"sourceId":"south-africa-government-irp-2025","locator":"capture:/retrievedAt","rawValue":"2026-07-17T16:14:47.506Z","normalizedValue":"2026-07-17T16:15:17.173Z","unit":null,"year":null},{"sourceId":"south-africa-government-rmippp-hybrid-projects-2023","locator":"capture:/retrievedAt","rawValue":"2026-07-17T16:14:52.987Z","normalizedValue":"2026-07-17T16:15:17.173Z","unit":null,"year":null},{"sourceId":"world-bank-country","locator":"capture:/retrievedAt","rawValue":"2026-07-17T16:14:54.768Z","normalizedValue":"2026-07-17T16:15:17.173Z","unit":null,"year":null},{"sourceId":"world-bank-gdp","locator":"capture:/retrievedAt","rawValue":"2026-07-17T16:15:15.975Z","normalizedValue":"2026-07-17T16:15:17.173Z","unit":null,"year":null},{"sourceId":"world-bank-gdp-growth","locator":"capture:/retrievedAt","rawValue":"2026-07-17T16:15:17.173Z","normalizedValue":"2026-07-17T16:15:17.173Z","unit":null,"year":null},{"sourceId":"world-bank-population","locator":"capture:/retrievedAt","rawValue":"2026-07-17T16:15:15.746Z","normalizedValue":"2026-07-17T16:15:17.173Z","unit":null,"year":null}],"extractionMethod":"deterministic","uncertainty":null},{"factId":"fact-776f0cc287c68a3e","fieldPath":"marketOverview.countryCode","status":"candidate","evidence":[{"sourceId":"world-bank-country","locator":"json:/1/0/iso2Code","rawValue":"ZA","normalizedValue":"ZA","unit":null,"year":null}