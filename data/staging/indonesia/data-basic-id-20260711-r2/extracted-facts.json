normalizedValue":2025,"unit":"kWh/person","year":2025}],"extractionMethod":"manual","uncertainty":null},{"factId":"fact-80a1e8804101bcd9","fieldPath":"marketOverview.overview","status":"candidate","evidence":[{"sourceId":"indonesia-esdm-2025-performance","locator":"html:press-release-002-pers-04-sji-2026#paragraph-127","rawValue":{"electricityInvestmentUsdBillion":4.6,"renewablesConservationInvestmentUsdBillion":2.4,"totalInvestmentUsdBillion":31.7},"normalizedValue":{"en":"Energy and mineral investment reached USD 31.7 billion in 2025, including USD 4.6 billion in electricity and USD 2.4 billion in renewables and conservation. Installed renewable capacity reached 15,630 MW, including 1,494 MW of solar and 152 MW of wind.","zh":"2025年能源与矿产领域投资为317亿美元，其中电力46亿美元、可再生能源与节能24亿美元。可再生能源装机达到15,630兆瓦，其中太阳能1,494兆瓦、风电152兆瓦。"},"unit":null,"year":null},{"sourceId":"indonesia-esdm-2025-performance","locator":"html:press-release-002-pers-04-sji-2026#paragraph-129","rawValue":{"renewableCapacityMw":15630,"solarCapacityMw":1494,"windCapacityMw":152},"normalizedValue":{"en":"Energy and mineral investment reached USD 31.7 billion in 2025, including USD 4.6 billion in electricity and USD 2.4 billion in renewables and conservation. Installed renewable capacity reached 15,630 MW, including 1,494 MW of solar and 152 MW of wind.","zh":"2025年能源与矿产领域投资为317亿美元，其中电力46亿美元、可再生能源与节能24亿美元。可再生能源装机达到15,630兆瓦，其中太阳能1,494兆瓦、风电152兆瓦。"},"unit":null,"year":null}],"extractionMethod":"manual","uncertainty":null},{"factId":"fact-23ca2a3293b7ec25","fieldPath":"marketOverview.population","status":"candidate","evidence":[{"sourceId":"world-bank-population","locator":"json:/1/0/value","rawValue":285721236,"normalizedValue":285721236,"unit":"people","year":2025}],"extractionMethod":"deterministic","uncertainty":null},{"factId":"fact-d2f22001f3963d95","fieldPath":"marketOverview.renewableTarget","status":"candidate","evidence":[{"sourceId":"indonesia-esdm-2025-performance","locator":"html:press-release-002-pers-04-sji-2026#paragraph-129","rawValue":{"actualRenewableMixPercent":15.75,"year":2025},"normalizedValue":{"en":"The 2025 National Energy Policy sets new and renewable energy share targets of 19%-23% in 2030, 36%-40% in 2040, 53%-55% in 2050, and 70%-72% in 2060. The Ministry reported a 15.75% share in 2025.","zh":"2025年《国家能源政策》将新能源和可再生能源占比目标设为2030年19%至23%、2040年36%至40%、2050年53%至55%、2060年70%至72%。能源矿产资源部报告2025年实际占比为15.75%。"},"unit":null,"year":null},{"sourceId":"indonesia-esdm-national-energy-policy-2025","locator":"pdf:page=16#article-10-a-1-to-3","rawValue":{"2030":[19,23],"2040":[36,40],"2050":[53,55]},"normalizedValue":{"en":"The 2025 National Energy Policy sets new and renewable energy share targets of 19%-23% in 2030, 36%-40% in 2040, 53%-55% in 2050, and 70%-72% in 2060. The Ministry reported a 15.75% share in 2025.","zh":"2025年《国家能源政策》将新能源和可再生能源占比目标设为2030年19%至23%、2040年36%至40%、2050年53%至55%、2060年70%至72%。能源矿产资源部报告2025年实际占比为15.75%。"},"unit":null,"year":null},{"sourceId":"indonesia-esdm-national-energy-policy-2025","locator":"pdf:page=17#article-10-a-4","rawValue":{"2060":[70,72]},"normalizedValue":{"en":"The 2025 National Energy Policy sets new and renewable energy share targets of 19%-23% in 2030, 36%-40% in 2040, 53%-55% in 2050, and 70%-72% in 2060. The Ministry reported a 15.75% share in 2025.","zh":"2025年《国家能源政策》将新能源和可再生能源占比目标设为2030年19%至23%、2040年36%至40%、2050年53%至55%、2060年70%至72%。能源矿产资源部报告2025年实际占比为15.75%。"},"unit":null,"year":null}],"extractionMethod":"manual","uncertainty":null},{"factId":"fact-77a3f126639e9ebb","fieldPath":"marketOverview.source","status":"candidate","evidence":[{"sourceId":"indonesia-esdm-2025-performance","locator":"metadata:/sourceName","rawValue":"Indonesia Ministry of Energy and Mineral Resources","normalizedValue":"Indonesia Ministry of Energy and Mineral Resources","unit":null,"year":null}],"extractionMethod":"deterministic","uncertainty":null},{"factId":"fact-59776c7311313e06","fieldPath":"marketOverview.sourceUrl","status":"candidate",