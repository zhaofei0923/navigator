  "streamlined_governance": {
    "d1_p": "按提供方和数据集一次准入，数据负责人和合规负责人共同签署；系统生成60国乘以三个Basic域的矩阵。",
    "d2_p": "国家主数据、宏观和能源三个批次；运行、哈希、水位和停止信号机器校验，干净批次由授权数据审核人一次关闭。",
    "d3_p": "解析、标准化和实体匹配可重放；只对未知枚举、模糊匹配、冲突、高风险翻译和人工合并进行异常审核。",
    "d4_p": "全部发布值机器校验，60个中文名全量复核，冻结180个有值样本由两名独立审核人复核，所有待补值和异常全量复核，五类角色在一个最终包中集中签署。"
  },
  "mandatory_controls": [
    "所有真实数据服务、数据库、网络、卷、密钥和账号与synthetic_demo隔离",
    "页面持续显示私有试用、数据截至和非正式结论标识",
    "原始材料保持不可变并以清单和SHA-256绑定，不提交受限原件或1.21GB raw material到Git",
    "来源条款、许可、访问和用途未经具名审核不得转active",
    "缺失值保持pending或unknown，不得以0或低风险替代",
    "政策、搜索和AI接口不得在真实私有试用路由中注册",
    "撤权来源必须从活动发布快照和只读API中移除且保留历史",
    "发现越界数据、权限泄漏、许可变化或误导性展示时立即撤销私有试用发布"
