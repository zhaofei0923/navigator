{
  "name": "@navigator/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "tsc --project tsconfig.json --noEmit --pretty false",
    "prisma": "prisma",
    "prisma:validate": "DATABASE_URL=${DATABASE_URL:-postgresql://navigator:navigator@localhost:5432/navigator} prisma validate --schema prisma/schema.prisma",
    "preflight:basic-activation": "node --experimental-transform-types --experimental-loader ../../scripts/node-ts-source-loader.mjs src/seed/basic-country-activation-preflight-cli.ts",
    "seed:indonesia": "node src/seed/indonesia-seed.ts",
    "typecheck": "tsc --project tsconfig.json --noEmit --pretty false",
    "test": "vitest run"
  },
  "dependencies": {
    "@navigator/shared-types": "workspace:*",
    "@prisma/client": "^6.19.3"
  },
  "devDependencies": {
    "prisma": "^6.19.3"
  }
}
