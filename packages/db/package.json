{
  "name": "@navigator/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./country-read-runtime": {
      "types": "./src/read/country-read-runtime.ts",
      "development": "./src/read/country-read-runtime.ts",
      "default": "./dist/read/country-read-runtime.js"
    }
  },
  "scripts": {
    "prebuild": "pnpm --filter @navigator/shared-types build",
    "build": "tsc --project tsconfig.build.json",
    "build:basic-candidate-native": "node scripts/build-basic-candidate-native.mjs",
    "lint": "tsc --project tsconfig.json --noEmit --pretty false",
    "prisma": "prisma",
    "prisma:validate": "DATABASE_URL=${DATABASE_URL:-postgresql://navigator:navigator@localhost:5432/navigator} prisma validate --schema prisma/schema.prisma",
    "precandidate:basic-country": "pnpm run build:basic-candidate-native",
    "candidate:basic-country": "node --conditions=development --import ../../scripts/node-ts-source-hook.mjs src/cli/candidate-basic-country.ts",
    "basic:prepare-batch": "node --conditions=development --import ../../scripts/node-ts-source-hook.mjs src/cli/prepare-basic-batch.ts",
    "preflight:basic-activation": "node --conditions=development --import ../../scripts/node-ts-source-hook.mjs src/seed/basic-country-activation-preflight-cli.ts",
    "seed:approved-basic-country": "node --conditions=development --experimental-transform-types --import ../../scripts/node-ts-source-hook.mjs src/seed/approved-basic-country-import.ts",
    "import:approved-basic-publications": "node --conditions=development --experimental-transform-types --import ../../scripts/node-ts-source-hook.mjs src/seed/approved-basic-countries-prisma-import-cli.ts",
    "validate:approved-basic-publications": "node --conditions=development --experimental-transform-types --import ../../scripts/node-ts-source-hook.mjs src/seed/approved-basic-publications-validation.ts",
    "typecheck": "tsc --project tsconfig.json --noEmit --pretty false",
    "pretest": "pnpm run build:basic-candidate-native",
    "test": "vitest run"
  },
  "dependencies": {
    "@navigator/shared-types": "workspace:*",
    "@prisma/client": "^6.19.3",
    "csv-parse": "7.0.1"
  },
  "devDependencies": {
    "prisma": "^6.19.3"
  }
}
