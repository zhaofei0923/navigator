# Copy to /opt/navigator/basic60/.env.remote and chmod 600. Never commit real values.
# This separate environment must not reuse the old synthetic Demo's secrets.
NAVIGATOR_BASIC60_WEB_PORT=3101
NAVIGATOR_BASIC60_ORIGIN=https://navigator.easudata.com
NAVIGATOR_POSTGRES_IMAGE=postgres:18-alpine
NAVIGATOR_API_IMAGE=navigator-basic60-api:replace-with-immutable-source-tag
NAVIGATOR_WEB_IMAGE=navigator-basic60-web:replace-with-immutable-source-tag
NAVIGATOR_SOURCE_SNAPSHOT_SHA256=replace-with-64-character-source-sha256

NAVIGATOR_BASIC60_DB_PASSWORD=replace-with-random-database-password
NAVIGATOR_BASIC60_API_KEY=replace-with-random-api-key
# Retained for the Basic60 contract, not an enabled login in approved_basic60_demo.
NAVIGATOR_BASIC60_SHARED_PASSPHRASE=replace-with-random-unused-private-profile-passphrase
NAVIGATOR_BASIC60_SESSION_SECRET=replace-with-at-least-32-random-characters
# Must verify the supplied machine attestation. This short placeholder is invalid.
NAVIGATOR_BASIC60_RUNTIME_ATTESTATION_KEY=replace-me

# Protected, real directories and files; never symlinks or public/static directories.
# Runtime contains only the finalized ready seed and matching machine attestation.
NAVIGATOR_BASIC60_RUNTIME_DIR=/opt/navigator/basic60/data/basic60
NAVIGATOR_MARKET_CONTENT_DIR=/opt/navigator/basic60/data/market-content
NAVIGATOR_BASIC60_DECISION_FILE=/opt/navigator/basic60/governance/basic60_decision.json
NAVIGATOR_BASIC60_RELEASE_AUTHORIZATION_FILE=/opt/navigator/basic60/governance/basic60_release_authorization.json
NAVIGATOR_BASIC60_VALIDATION_REPORT_FILE=/opt/navigator/basic60/governance/basic60_private_validation.json

# Bind the exact confirmed and transferred artifacts. Do not invent approvals.
NAVIGATOR_BASIC60_DECISION_SHA256=replace-with-64-character-sha256
NAVIGATOR_BASIC60_RELEASE_AUTHORIZATION_SHA256=replace-with-64-character-sha256
NAVIGATOR_BASIC60_VALIDATION_REPORT_SHA256=replace-with-64-character-sha256
NAVIGATOR_BASIC60_RUNTIME_ATTESTATION_SHA256=replace-with-64-character-sha256
