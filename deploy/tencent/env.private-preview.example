# Copy to /opt/navigator/.env.remote and chmod 600. Never commit real values.
NAVIGATOR_HOSTNAME=navigator.easudata.com
NAVIGATOR_WEB_PORT=3100
NAVIGATOR_POSTGRES_IMAGE=postgres:18-alpine
NAVIGATOR_API_IMAGE=navigator-demo-api:replace-with-immutable-preview-tag
NAVIGATOR_WEB_IMAGE=navigator-demo-web:replace-with-immutable-preview-tag
NAVIGATOR_SOURCE_SNAPSHOT_SHA256=replace-with-source-snapshot-sha256
NAVIGATOR_DB_PASSWORD=
NAVIGATOR_DEMO_ACCESS_KEY=
NAVIGATOR_DEMO_PASSPHRASE=
NAVIGATOR_DEMO_SESSION_SECRET=
