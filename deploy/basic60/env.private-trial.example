# Copy to an untracked file outside the repository or to .env.basic60.local.
NAVIGATOR_BASIC60_DB_PASSWORD=replace-with-random-database-password
NAVIGATOR_BASIC60_API_KEY=replace-with-random-api-key
NAVIGATOR_BASIC60_SHARED_PASSPHRASE=replace-with-high-entropy-private-trial-passphrase
NAVIGATOR_BASIC60_SESSION_SECRET=replace-with-at-least-32-random-characters
# Intentionally invalid short placeholder. Generate at least 32 random bytes; never commit it.
NAVIGATOR_BASIC60_RUNTIME_ATTESTATION_KEY=replace-me

# Absolute host paths. The runtime directory contains the finalized seed and machine attestation.
NAVIGATOR_BASIC60_RUNTIME_DIR=/absolute/path/to/navigator/runtime/basic60
# Independent published market-analysis/report volume. Leave empty until this content's Excel
# has actually been reviewed and explicitly confirmed. Never point this at candidate or research.
NAVIGATOR_MARKET_CONTENT_DIR=/absolute/path/to/navigator/runtime/market-content
NAVIGATOR_BASIC60_DECISION_FILE=/absolute/path/to/basic60_private_baseline_decision.json
NAVIGATOR_BASIC60_RELEASE_AUTHORIZATION_FILE=/absolute/path/to/basic60_release_authorization.json
NAVIGATOR_BASIC60_VALIDATION_REPORT_FILE=/absolute/path/to/navigator/runtime/basic60/basic60_private_validation.json

# Compute after the actual human-approved files have been created.
NAVIGATOR_BASIC60_DECISION_SHA256=replace-with-64-character-sha256
NAVIGATOR_BASIC60_RELEASE_AUTHORIZATION_SHA256=replace-with-64-character-sha256
NAVIGATOR_BASIC60_VALIDATION_REPORT_SHA256=replace-with-64-character-sha256
NAVIGATOR_BASIC60_RUNTIME_ATTESTATION_SHA256=replace-with-64-character-sha256

# Approved existing-Demo entry. Use 3200 only for the standalone /basic60 profile.
NAVIGATOR_BASIC60_ORIGIN=http://127.0.0.1:3000
NAVIGATOR_BASIC60_WEB_PORT=3000
NAVIGATOR_BASIC60_COOKIE_SECURE=false
